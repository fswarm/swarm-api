# Procfile for various hosting platforms

# Heroku
web: uvicorn fastapi_swarms_backend:app --host 0.0.0.0 --port $PORT

# Railway/Render
web: uvicorn fastapi_swarms_backend:app --host 0.0.0.0 --port $PORT

# Digital Ocean App Platform
worker: uvicorn fastapi_swarms_backend:app --host 0.0.0.0 --port $PORT